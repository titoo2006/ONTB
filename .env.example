# SECURITY.md §7 — no key is ever hardcoded in source, including seed/test scripts.
# Copy to .env.local and fill in. .env.local is gitignored and never committed.

# ---------------------------------------------------------------------------
# CLIENT-SAFE (shipped to the browser bundle — these two only)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY — must never reach the client bundle. No NEXT_PUBLIC_ prefix, ever.
# ---------------------------------------------------------------------------

# Supabase service role — bypasses RLS. Used only inside lib/services.
SUPABASE_SERVICE_ROLE_KEY=

# Paymob (SECURITY.md §1, §7)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# Site origin used to build Paymob return URLs and emailed ticket links.
APP_BASE_URL=http://localhost:3000

# Signs ticket-access links (SECURITY.md §2 second factor). Minimum 32 chars —
# the code refuses a shorter one, because a guessable signing key makes the
# second factor decorative. Generate with: openssl rand -base64 48
TICKET_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# ANALYTICS
# Every one of these is optional. Leave blank and the corresponding script is
# simply never injected — the site works fully without any of them.
# Nothing here loads before the guest has consented to the matching category.
# ---------------------------------------------------------------------------

# Meta Pixel — loaded ONLY with marketing consent. Client-side, so public.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API — SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# Used by the payment webhook to send the authoritative Purchase event.
META_CAPI_ACCESS_TOKEN=

# PostHog — loaded ONLY with analytics consent.
# Host must stay on the EU cloud: data residency was a condition of choosing it.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
